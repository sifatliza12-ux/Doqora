# Database (Vercel Postgres / Neon)
# DATABASE_URL: pooled connection (via pgbouncer) — used by the app at runtime.
# DIRECT_URL: direct (non-pooled) connection — used by Prisma for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Signing secret for the /api/webhooks/clerk endpoint (from the Clerk Dashboard
# webhook's "Signing Secret", starts with "whsec_"). Required to verify that
# incoming webhook requests actually came from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=""
# Point Clerk at our self-hosted auth pages instead of the hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Signs the short-lived tokens that authorize headless Chromium's internal
# /print/invoice/[id] navigation (see src/lib/print-token.ts). Any long
# random string; rotating it just invalidates in-flight print jobs.
PRINT_TOKEN_SECRET=""

# Upstash Redis (via Vercel's "Upstash for Redis" marketplace integration —
# `vercel env pull` to fetch these). Backs the distributed rate limiter in
# src/lib/rate-limit.ts.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
